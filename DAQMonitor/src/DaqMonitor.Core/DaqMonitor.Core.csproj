<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 本机只装了 .NET 10 运行时，用 RollForward=Major 让 net8.0 应用滚动到 net10 运行（生产常用技巧，项目本身仍是 net8.0） -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DaqMonitor.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- 串口通信（🟩 .NET 官方串口类，免费开源；M1 SerialDevice 真实硬件用） -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- 持久化：EF Core + SQLite（M4 存储 → 历史库落地，UI/采集层无感知） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MQTT 上云（M7 修正版双向）：MQTTnet 4.x，必须用 v4 管线 API（MqttFactory().CreateMqttClient） -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaqMonitor.Tests" />
  </ItemGroup>

</Project>
