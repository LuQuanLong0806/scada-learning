<UserControl x:Class="DaqMonitor.UI.Views.MotionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部:急停(红色,大)+ 提示 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="🎮 运动控制 · 模拟 2 轴"/>
            <Button Grid.Column="1" Content="⛔ 急停全部" Width="120" Height="40" FontSize="14" FontWeight="Bold"
                    Background="#C0392B" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Command="{Binding EmergencyStopAllCommand}"
                    ToolTip="IEC 60204-1 安全要求:立即停止所有轴"/>
        </Grid>

        <!-- 主区:每轴一行(Group + 状态 + 操作) -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Axes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#3D5063" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 头:轴名 + 当前位置 + 状态 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="22" FontWeight="Bold"
                                           Foreground="#00A0FF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                    <Run Text="位置:" FontSize="12" Foreground="#888"/>
                                    <Run Text="{Binding CurrentPosition, StringFormat=F2}" FontSize="22" FontWeight="Bold"/>
                                    <Run Text=" mm" FontSize="12" Foreground="#888"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="13"
                                           Foreground="#888" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 操作区:目标位置 + 速度 + 定位/回零 + Jog -->
                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                <!-- 绝对定位 -->
                                <TextBlock Text="目标:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding MoveTarget, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" Margin="0,0,8,0" Padding="4"/>
                                <TextBlock Text="@ 速度:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding MoveVelocity, UpdateSourceTrigger=PropertyChanged}"
                                         Width="50" Margin="0,0,8,0" Padding="4"/>
                                <Button Content="🎯 绝对" Command="{Binding MoveAbsCommand}" Width="70" Height="28"
                                        Background="#00A0FF" Foreground="White" Margin="0,0,4,0"
                                        ToolTip="未回零会拒绝执行"/>
                                <Button Content="↔ 相对" Command="{Binding MoveRelCommand}" Width="60" Height="28"
                                        Background="#5DADE2" Foreground="White" Margin="0,0,8,0"
                                        ToolTip="从当前位置走 MoveTarget 增量"/>

                                <!-- 回零 -->
                                <Button Content="🏠 回零" Command="{Binding HomeCommand}" Width="65" Height="28"
                                        Background="#27AE60" Foreground="White" Margin="0,0,8,0"
                                        ToolTip="以慢速回原点,确定位置基准"/>

                                <!-- Jog 点动 -->
                                <TextBlock Text="Jog" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding JogSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Width="40" Margin="0,0,4,0" Padding="4"/>
                                <Button Content="◀" Tag="neg" Width="32" Height="28"
                                        PreviewMouseDown="Jog_Down" PreviewMouseUp="Jog_Up"
                                        Background="#8E44AD" Foreground="White"/>
                                <Button Content="▶" Tag="pos" Width="32" Height="28" Margin="4,0,0,0"
                                        PreviewMouseDown="Jog_Down" PreviewMouseUp="Jog_Up"
                                        Background="#8E44AD" Foreground="White"/>

                                <!-- 停止 -->
                                <Button Content="⏹ 停止" Command="{Binding StopCommand}" Width="65" Height="28"
                                        Background="#E67E22" Foreground="White" Margin="8,0,0,0"/>
                                <Button Content="🔄 清报警" Command="{Binding ResetAlarmCommand}" Width="75" Height="28"
                                        Background="#7F8C8D" Foreground="White" Margin="4,0,0,0"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}"
                   FontSize="11" Foreground="#888" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <!-- 架构说明 -->
        <TextBlock Grid.Row="3" Margin="0,4,0,0" FontSize="10" Foreground="Gray" TextWrapping="Wrap">
            抽象:IAxisController 接口对齐 PLCopen Motion 标准(MoveAbsolute/MoveRelative/Home/Stop/Jog)。
            当前模拟实现 10ms tick 推进位置;真实工程接固高/雷赛/正运动卡只需换实现,UI 零改动。
            急停符合 IEC 60204-1;软限位保护机械碰撞;回零后才能绝对定位。
        </TextBlock>
    </Grid>
</UserControl>
