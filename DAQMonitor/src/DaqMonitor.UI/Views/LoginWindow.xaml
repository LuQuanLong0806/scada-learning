<Window x:Class="DaqMonitor.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAQ Monitor · 登录" Height="400" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E2A38"
        Foreground="White">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo / 标题 -->
        <TextBlock Grid.Row="0" Text="⚡ DAQ Monitor"
                   FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center" Foreground="#00A0FF"/>
        <TextBlock Grid.Row="2" Text="工业数据采集监控系统"
                   FontSize="13" Opacity="0.7"
                   HorizontalAlignment="Center"/>

        <!-- 用户名 -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="用户名" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="8,6"
                     Background="#2C3E50" Foreground="White" BorderBrush="#3D5063"/>
        </StackPanel>

        <!-- 密码 -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="密码" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         FontSize="14" Padding="8,6"
                         Background="#2C3E50" Foreground="White" BorderBrush="#3D5063"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
        </StackPanel>

        <!-- 错误提示 -->
        <TextBlock Grid.Row="8" Text="{Binding Error}"
                   Foreground="#FF3B30" FontSize="12"
                   TextWrapping="Wrap" MinHeight="16"/>

        <!-- 登录按钮 -->
        <Button Grid.Row="10" Content="登 录"
                Command="{Binding LoginCommand}"
                Padding="0,12" FontSize="14" FontWeight="Bold"
                Background="#00A0FF" Foreground="White" BorderThickness="0"
                Cursor="Hand"/>

        <!-- 默认账号提示(开发期便利,生产部署应去掉) -->
        <TextBlock Grid.Row="10" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Margin="0,0,0,-20"
                   FontSize="10" Opacity="0.5" Text="admin/admin123 · engineer/engineer123 · operator/operator123"/>
    </Grid>
</Window>
