<UserControl x:Class="DaqMonitor.UI.Views.RecipeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DaqMonitor.UI.ViewModels">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏:激活/新增/编辑/删除/导出/导入/刷新 -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="🔄 刷新" Command="{Binding RefreshCommand}" Width="70" Height="28" Margin="0,0,4,0"/>
            <Button Content="🟢 激活此配方" Command="{Binding ActivateCommand}" Width="110" Height="28" Margin="0,0,4,0"
                    Background="#27AE60" Foreground="White"
                    ToolTip="换产品时的标准动作。Operator 可用"/>
            <Button Content="➕ 新增" Command="{Binding NewCommand}" Width="70" Height="28" Margin="0,0,4,0"
                    Background="#00A0FF" Foreground="White"
                    ToolTip="权限:Engineer 及以上"/>
            <Button Content="✏ 编辑" Command="{Binding EditCommand}" Width="70" Height="28" Margin="0,0,4,0"
                    Background="#00A0FF" Foreground="White"
                    ToolTip="权限:Engineer 及以上"/>
            <Button Content="🗑 删除" Command="{Binding DeleteCommand}" Width="70" Height="28" Margin="0,0,4,0"
                    Background="#E74C3C" Foreground="White"
                    ToolTip="权限:Engineer 及以上(软删除)"/>
            <Button Content="📤 导出" Command="{Binding ExportCommand}" Width="70" Height="28" Margin="0,0,4,0"
                    Background="#8E44AD" Foreground="White"
                    ToolTip="导出为 JSON,跨设备复制"/>
            <Button Content="📥 导入" Command="{Binding ImportCommand}" Width="70" Height="28"
                    Background="#8E44AD" Foreground="White"
                    ToolTip="从 JSON 文件导入"/>
        </WrapPanel>

        <!-- 主区:左列表 + 右参数表 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- 左:配方列表 -->
            <GroupBox Grid.Column="0" Header="配方列表">
                <DataGrid ItemsSource="{Binding Recipes}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="13"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="50"/>
                        <DataGridCheckBoxColumn Header="激活" Binding="{Binding IsActive}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="创建者" Binding="{Binding CreatedByUsername}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- 右:选中配方的参数表(只读,编辑请点 ✏ 按钮) -->
            <GroupBox Grid.Column="2" Header="参数预览(只读)">
                <DataGrid ItemsSource="{Binding Parameters}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="参数" Binding="{Binding Key}" Width="*"/>
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="80"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="60"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="60"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}"
                   FontSize="11" Foreground="#888" Margin="0,6,0,0"
                   TextWrapping="Wrap"/>

        <!-- 架构说明(给学习者讲清"为什么这么做") -->
        <TextBlock Grid.Row="3" Margin="0,4,0,0" FontSize="10" Foreground="Gray" TextWrapping="Wrap">
            设计:激活互斥靠 DB 事务(同时只能一个 IsActive=true);每次 Update 自动写快照 + 版本号自增,支持回滚;
            软删除保审计链;所有写操作落 AuditLog(FDA 21 CFR Part 11 要求)。
        </TextBlock>
    </Grid>
</UserControl>
