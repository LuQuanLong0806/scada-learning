<Window x:Class="DaqMonitor.UI.Views.RecipeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配方编辑" Height="520" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#1E2A38" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="配方编辑(Engineer 及以上)" FontSize="14" FontWeight="Bold" Foreground="#00A0FF"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="配方名" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" FontSize="14" Padding="6"
                     Background="#2C3E50" Foreground="White" BorderBrush="#3D5063"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="描述" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox x:Name="DescBox" FontSize="14" Padding="6"
                     Background="#2C3E50" Foreground="White" BorderBrush="#3D5063"/>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="参数 JSON(每行一个,格式:{key,value,unit,type,min,max})"
                       FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox x:Name="ParamsBox" FontSize="13" Padding="6"
                     FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="#2C3E50" Foreground="White" BorderBrush="#3D5063"
                     Height="280"/>
            <TextBlock x:Name="ErrorBlock" Foreground="#FF3B30" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Padding="0,8" Margin="0,0,8,0" IsCancel="True"
                    Background="#3D5063" Foreground="White" BorderThickness="0"/>
            <Button Content="保存" Width="80" Padding="0,8" Click="Save_Click"
                    Background="#00A0FF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
